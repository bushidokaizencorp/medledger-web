{
  "name": "medledger-web",
  "version": "1.0.0",
  "description": "MedLedger ERP — Bushido Kaizen Corporation",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node src/server.js",
    "migrate": "knex migrate:latest --knexfile src/db/knexfile.js",
    "rollback": "knex migrate:rollback --knexfile src/db/knexfile.js",
    "seed": "node src/db/seed.js",
    "test": "vitest run",
    "db:reset": "rm -f medledger.db && npm run migrate && npm run seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "mssql": "^12.7.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}