# Copy to .env and edit. NEVER commit .env.

NODE_ENV=production
PORT=8080

# --- Database ---
# Local dev/tests use SQLite with zero setup:
#   DB_CLIENT=sqlite3
# Production uses SQL Server:
DB_CLIENT=mssql
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=medledger
DB_USER=sa
DB_PASSWORD=Change_This_Strong_Password_1!
DB_ENCRYPT=true

# --- Auth ---  generate: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32_value_at_least_32_bytes
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

# --- Security ---
CORS_ORIGINS=https://erp.bushidokaizencorporation.com
COOKIE_SECURE=true
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# --- Compliance adapters ---
# simulator until you have ZIMRA device credentials / MCAZ endpoint access
FDMS_MODE=simulator
FDMS_BASE_URL=
FDMS_DEVICE_ID=
MCAZ_MODE=simulator
MCAZ_BASE_URL=
